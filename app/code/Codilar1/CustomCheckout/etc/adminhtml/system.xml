<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/system_file.xsd">
    <system>
        <tab id="custom_tab" translate="label" sortOrder="100">
            <label>Custom Tax</label>
        </tab>
        <section id="custom_tax_section" translate="label" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Custom Tax Settings</label>
            <tab>custom_tab</tab>
            <resource>Codilar1_CustomCheckout::config</resource>
            <group id="custom_tax_group" translate="label" type="text" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Custom Tax</label>
                <field id="rate" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tax Rate (%)</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <frontend_class>validate-number</frontend_class>
                </field>
            </group>
        </section>
    </system>
</config>
