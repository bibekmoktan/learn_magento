<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="customer_wallet" resource="default" engine="innodb" comment="Customer Wallet Table">
        <column xsi:type="int" name="wallet_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Wallet ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="decimal" name="balance" scale="4" precision="12" nullable="false" default="0.0000" comment="Wallet Balance"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="wallet_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="CUSTOMER_WALLET_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="customer_wallet" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="CUSTOMER_WALLET_CUSTOMER_ID">
            <column name="customer_id"/>
        </index>
    </table>
</schema>
